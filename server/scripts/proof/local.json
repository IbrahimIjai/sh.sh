{
  "links": 200000,
  "sessions": 200,
  "postgres_args": ["-c", "max_connections=200", "-c", "shared_buffers=256MB", "-c", "effective_cache_size=1GB"],
  "redis_maxmemory": "256mb",
  "api_env": {"LINK_CACHE_SIZE": "100000"},
  "limits": {
    "api": {"cpus": "1", "memory": "512m"},
    "db": {"cpus": "1.5", "memory": "1g"},
    "redis": {"cpus": "0.5", "memory": "320m"}
  },
  "hosts": {
    "laptop": {"ssh": "local", "roles": ["db", "redis", "api", "gen"], "api_instances": 2}
  }
}
