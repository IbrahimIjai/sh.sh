PORT=8080
APP_ENV=development
BASE_URL=http://localhost:8080

DATABASE_URL=postgres://postgres:postgres@localhost:5434/myapp?sslmode=disable

# goose reads these from .env automatically — run plain `goose up` / `goose status`
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:postgres@localhost:5434/myapp?sslmode=disable
GOOSE_MIGRATION_DIR=db/migrations
LIMEN_SECRET=your-32-byte-signing-secret-here

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/oauth/google/callback

RESEND_API_KEY=
RESEND_FROM="SH <onboarding@resend.dev>"
MAGIC_LINK_EMAIL_SUBJECT="Sign in to SH"
