PORT=8080
APP_ENV=development
BASE_URL=http://localhost:8080

DATABASE_URL=postgres://postgres:postgres@localhost:5434/myapp?sslmode=disable

# goose reads these from .env automatically — run plain `goose up` / `goose status`
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:postgres@localhost:5434/myapp?sslmode=disable
GOOSE_MIGRATION_DIR=db/migrations
LIMEN_SECRET=your-32-byte-signing-secret-here

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/oauth/google/callback

# Resend is the default; set EMAIL_PROVIDER=transend to switch back.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM="shortened.cv <no-reply@emails.shortened.cv>"

# Retained for when Transend is available again.
TRANSEND_API_KEY=
TRANSEND_FROM="shortened.cv <no-reply@mail.shortened.cv>"
MAGIC_LINK_EMAIL_SUBJECT="Sign in to shortened.cv"

# Click analytics / safety (all optional)
# Proxy IPs/CIDRs allowed to set X-Forwarded-For. Leave empty when nothing sits in front of the API.
TRUSTED_PROXIES=
# Set to "cloudflare" only if the API is reachable exclusively through Cloudflare.
TRUSTED_PLATFORM=
# MaxMind GeoLite2-City database for click country/city, e.g. /data/GeoLite2-City.mmdb
GEOIP_DB_PATH=
# Google Web Risk API key: new links pointing at malware/phishing are rejected.
WEB_RISK_API_KEY=
