PORT=8080
APP_ENV=development
BASE_URL=http://localhost:8080
# The UI's origin: it may call /api and /auth from the browser, and "/" redirects to it.
APP_URL=http://localhost:3000

DATABASE_URL=postgres://postgres:postgres@localhost:5434/myapp?sslmode=disable
# Apply pending db/migrations at startup. Set false to run them by hand with goose.
RUN_MIGRATIONS=true
# Per API process. Leave room for other replicas, migrations, and administration.
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=20

# goose reads these from .env automatically — run plain `goose up` / `goose status`
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:postgres@localhost:5434/myapp?sslmode=disable
GOOSE_MIGRATION_DIR=db/migrations
LIMEN_SECRET=your-32-byte-signing-secret-here

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/oauth/google/callback

# Resend is the default; set EMAIL_PROVIDER=transend to switch back.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM="shortened.cv <no-reply@emails.shortened.cv>"

# Retained for when Transend is available again.
TRANSEND_API_KEY=
TRANSEND_FROM="shortened.cv <no-reply@mail.shortened.cv>"
MAGIC_LINK_EMAIL_SUBJECT="Sign in to shortened.cv"

# Click analytics / safety (all optional)
# Proxy IPs/CIDRs allowed to set X-Forwarded-For. Leave empty when nothing sits in front of the API.
TRUSTED_PROXIES=
# Set to "cloudflare" only if the API is reachable exclusively through Cloudflare.
TRUSTED_PLATFORM=
# MaxMind GeoLite2-City database for click country/city, e.g. /data/GeoLite2-City.mmdb
GEOIP_DB_PATH=
# Google Web Risk API key: new links pointing at malware/phishing are rejected.
WEB_RISK_API_KEY=

# Redis: shared redirect cache, invalidation across API instances, exact anonymous rate limit.
# Leave empty to run without Redis. Local Docker Redis is on port 6380.
REDIS_URL=
# Serve an expired cached link this long past its TTL while PostgreSQL is failing.
LINK_CACHE_STALE=5m

# Admin API (takedown). At least 32 characters, e.g. `openssl rand -hex 32`. Empty disables it.
ADMIN_TOKEN=
# Internal listener for /metrics and /debug/pprof, e.g. :9090. Never route it through the public proxy.
METRICS_ADDR=
# Access log: all, errors (status >= 400) or off. A line per redirect costs CPU at high rates.
REQUEST_LOG=all

# Click pipeline and storage
# redis (the default when REDIS_URL is set): clicks go through the Redis stream sh:clicks, so an API
# crash loses at most ~20 ms of them. memory: straight from RAM to PostgreSQL.
CLICK_QUEUE=
# Above this much stream memory, new clicks go straight to PostgreSQL instead.
CLICK_STREAM_MAX_MB=64
CLICK_BUFFER_SIZE=100000
CLICK_BATCH_SIZE=1000
CLICK_WRITERS=2
# Click batches commit without waiting for the WAL flush; a PostgreSQL crash can lose ~0.6 s of clicks.
CLICK_ASYNC_COMMIT=true
# Raw clicks are kept this many days; daily rollups are kept forever.
CLICK_RAW_RETENTION_DAYS=30
MAINTENANCE_INTERVAL=15m
